---
import WaButton from './WaButton.astro';
import { SITE_TEMPLATE } from '../config';
// Section links live on the classic template, at / or /classic depending on which is live.
const isHome = /^\/(index|classic)?(\.html)?$/.test(Astro.url.pathname);
const home = isHome ? '' : SITE_TEMPLATE === 'classic' ? '/' : '/classic';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/">Longevity Engineer</a>
    <nav class="site-nav" aria-label="Main">
      <a class="desktop-only" href={`${home}#how`}>How it works</a>
      <a class="desktop-only" href={`${home}#why`}>Why not ChatGPT?</a>
      <a href={`${home}#faq`}>FAQ</a>
      <WaButton label="Join the beta" size="sm" class="desktop-only" />
    </nav>
  </div>
</header>
