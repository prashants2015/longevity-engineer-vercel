---
import { WHATSAPP_URL, CTA_LABEL } from '../config';

interface Props {
  label?: string;
  variant?: 'accent' | 'dark';
  size?: 'md' | 'sm';
  id?: string;
  class?: string;
}
const { label = CTA_LABEL, variant = 'accent', size = 'md', id, class: className } = Astro.props;
---
<a
  class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', className]}
  href={WHATSAPP_URL}
  id={id}
  rel="noopener"
  target="_blank"
>
