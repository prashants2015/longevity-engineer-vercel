---
// Shared <head> contents (SEO, OG, icons, fonts, analytics) for every layout.
import { SITE_NAME, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Defaults to the current path; set it when the same page is served at more than one URL.
  canonicalPath?: string;
  fontsUrl: string;
  themeColor: string;
}
const { title, description, noindex = false, canonicalPath, fontsUrl, themeColor } = Astro.props;
const path = canonicalPath ?? Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '');
const canonical = `${SITE_URL}${path || '/'}`;
const ogImage = `${SITE_URL}/og.png`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content={themeColor} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Longevity Engineer: Stop guessing what to eat." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Loaded without blocking render; each stylesheet's fallback stacks cover the swap. -->
<link rel="stylesheet" href={fontsUrl} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fontsUrl} /></noscript>
<script defer src="/_vercel/insights/script.js"></script>
