---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const doc = (await getEntry('legal', 'terms'))!;
const { Content } = await render(doc);
const title = doc.data.title ?? 'Terms of use';
---
<Base title={`${title} · Longevity Engineer`} description="Terms for using Longevity Engineer during its private beta.">
  <section class="page">
    <div class="container">
      <p class="label">Legal</p>
      <h1 class="h2">{title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Base>
