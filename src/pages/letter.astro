---
// Served at /letter, and at / too when SITE_TEMPLATE is 'letter' (see astro.config.mjs).
// Self-contained: its own paper-and-ink styles, not global.css.
import Head from '../components/Head.astro';
import { SITE_TEMPLATE, LETTER_PARAGRAPHS, LETTER_CTA_LABEL, WHATSAPP_URL, CONTACT_EMAIL } from '../config';

const noindex = SITE_TEMPLATE !== 'letter';

const FONTS_URL = 'https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400&display=swap';
// Written out rather than linked, so scrapers don't pick it up.
const emailText = CONTACT_EMAIL.replace('@', ' [at] ').replace(/\./g, ' [dot] ');
---
<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Longevity Engineer: a health assistant in your WhatsApp"
      description="A personal health assistant that lives in your WhatsApp. It learns your goals, body, sleep and calendar, and decides what you should eat next."
      noindex={noindex}
      canonicalPath="/"
      fontsUrl={FONTS_URL}
      themeColor="#f6f1e7"
    />
  </head>
  <body>
    <main class="letter">
      <h1 class="mark">
        <svg viewBox="0 0 120 100" width="84" height="70" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 80c-1-9 24-14 46-14 23 0 46 5 46 14 0 10-25 14-47 14-24 0-45-4-46-13" />
            <path d="M35 80c0-5 13-7 25-7 13 0 26 2 26 7 0 5-14 7-26 7-13 0-25-2-26-8" />
            <path d="M60 80c0-14-2-29 1-45" />
            <path d="M60 55c-10 0-22-8-26-20 12 0 23 8 26 20Z" />
            <path d="M61 42c3-12 13-22 27-24 0 14-12 24-27 24Z" />
            <path d="M60 55c-8-3-15-8-19-15M61 42c7-5 13-11 19-18" stroke-width="1.4" />
          </g>
        </svg>
        <span class="sr-only">Longevity Engineer</span>
      </h1>

      {LETTER_PARAGRAPHS.map((p) => <p>{p}</p>)}

      <p class="invite">
        <a href={WHATSAPP_URL} rel="noopener" target="_blank">
          {LETTER_CTA_LABEL}
          <svg viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 9c40-4 95-6 150-5 52 1 100 3 144-2M40 12c60-3 140-4 210-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          </svg>
        </a>
      </p>
    </main>

    <footer class="colophon">
      <p>© 2026 Longevity Engineer</p>
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
      <p>{emailText}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f6f1e7;
    --ink: #221f1a;
    --ink-2: #5a544a;
    --pen: #2e6a50;
    --serif: 'Newsreader', 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(20px, 1rem + 0.8vw, 25px);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .letter,
  .colophon {
    max-width: 33em;
    margin: 0 auto;
    padding-inline: 24px;
  }
  .letter { padding-block: clamp(56px, 14vh, 144px) clamp(48px, 10vh, 112px); }
  .letter p { margin: 0 0 1.15em; }
  .mark { margin: 0 0 clamp(40px, 8vh, 72px); color: var(--ink); line-height: 0; }
  .mark svg { display: block; }
  .invite { margin-top: 2em !important; }
  .invite a {
    position: relative;
    display: inline-block;
    padding-bottom: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .invite svg {
    position: absolute;
    left: -2%;
    bottom: -4px;
    width: 104%;
    height: 14px;
    color: var(--pen);
    overflow: visible;
  }
  .invite a:hover { color: var(--pen); }
  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding-block: 32px 48px;
    font-size: 16px;
    color: var(--ink-2);
  }
  .colophon p { margin: 0; }
  .colophon nav { display: flex; gap: 20px; }
  .colophon a { color: var(--ink-2); text-underline-offset: 3px; }
  .colophon a:hover { color: var(--ink); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
